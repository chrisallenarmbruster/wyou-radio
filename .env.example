# WYOU Radio — chrisallenarmbruster/wyou-radio

# Application
DOCKER_REGISTRY="registry.rev4labs.com"
DOCKER_IMAGE_NAME="wyouradio"
APP_VERSION="1.1.1"
APP_REPLICAS="1"
QUIET="true"
PORT="3000"

# Database
POSTGRES_VERSION="16.2-bookworm"
POSTGRES_DB="wyouradio"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
DATABASE_URL=""

# Spotify and sessions
SPOTIFY_REDIRECT_URI_DEV="http://localhost:3000"
SPOTIFY_REDIRECT_URI_PROD="https://wyouradio.rev4labs.com"
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SESSION_SECRET=""

# AI, voice and location services
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
OPEN_WEATHER_API_KEY=""
LOCATION_IQ_API_KEY=""

# Tracing
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""

# Backups
BACKUP_REPLICAS="0"
POSTGRES_BACKUP_SCHEDULE="15 3 * * 0"
POSTGRES_BACKUP_TIMEZONE="America/Chicago"
POSTGRES_BACKUP_KEEP_MINUTES="10080"
POSTGRES_BACKUP_KEEP_DAYS="7"
POSTGRES_BACKUP_KEEP_WEEKS="4"
POSTGRES_BACKUP_KEEP_MONTHS="3"
